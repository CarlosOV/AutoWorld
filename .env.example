# LLM
OPENROUTER_API_KEY=sk-or-your-key-here
# Free models available on openrouter.ai/models?q=free
# LLM_MODEL=mistralai/mistral-7b-instruct:free
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_MODEL=qwen/qwen3-235b-a22b:free
LLM_MODEL=minimax/minimax-m2.5:free
LLM_MAX_TOKENS=0        # 0 = sin límite (recomendado para modelos de razonamiento free)
WORLD_LANGUAGE=Spanish  # idioma del mundo: Spanish, English, French, Portuguese, etc.

# World config
WORLD_NAME=Aethoria
NUM_AGENTS=5
TICK_INTERVAL=30
MAX_AGENTS=20
WEB_PORT=8000

# Database — leave blank for local SQLite, set for PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/autoworld
POSTGRES_PASSWORD=changeme

# Memory / context tuning
RECENT_EVENTS_WINDOW=8    # full events shown to LLM per prompt
COMPRESS_EVERY=30          # compress lore every N events
MAX_LORE_CHARS=600         # max chars for compressed history
AGENT_MEMORY_CAP=6         # max memory entries per agent

# Optional: Telegram notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
